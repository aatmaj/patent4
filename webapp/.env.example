# Copy to .env.local and fill in. .env.local is gitignored.

# ── Required ─────────────────────────────────────────────────────────────
# Google AI Studio key (https://aistudio.google.com/apikey). GOOGLE_API_KEY is
# accepted as a fallback name.
GEMINI_API_KEY=

# ── Google Cloud credentials (pick ONE) ──────────────────────────────────
# 1. Inline service-account JSON, raw or base64. The only option that works
#    on serverless/containers, where there is no repo checkout to read from.
# GCP_CREDENTIALS_JSON=

# 2. Path to a key file.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/credentials.json

# 3. Neither: falls back to ../credentials.json relative to this directory,
#    which is the local-development default. Never commit that file.

# ── Optional ─────────────────────────────────────────────────────────────
# GCP_PROJECT_ID=gen-lang-client-0471305973
# GEMINI_MODEL=gemini-3.1-pro-preview     # or gemini-3.7-flash for a cheaper run

# Reasoning tokens are billed against Gemini's output ceiling and cannot be
# disabled on the Pro models, so this is added to every max_tokens the agents
# ask for. Raise it if you see truncated JSON envelopes.
# THINKING_RESERVE_TOKENS=8192
# LLM_MAX_RETRIES=2

# Model tiers. Both default to GEMINI_MODEL.
#   GEMINI_CLASSIFIER_MODEL  the FTO batch classifier
#   GEMINI_UTILITY_MODEL     NL->SQL generation and the physchem annotation
#
# Setting all three to gemini-3.7-flash puts a full run under 100 s (measured:
# 68 s Metformin, 91 s Semaglutide, versus 152-230 s on Pro). See the README
# table before adopting it — the orchestrator is the reasoning core.
# GEMINI_CLASSIFIER_MODEL=gemini-3.7-flash
# GEMINI_UTILITY_MODEL=gemini-3.7-flash

# Concurrent Google Patents document fetches. 12 is the measured knee; higher
# risks throttling, which costs recall.
# PATENT_TEXT_CONCURRENCY=12

# Cost ceilings. BQ_MAX_BYTES_BILLED is the hard limit per BigQuery job;
# model-generated SQL is rejected above it rather than run.
# BQ_MAX_BYTES_BILLED=21474836480
# BQ_TIMEOUT_MS=60000
# HTTP_TIMEOUT_MS=20000
# MAX_ITERATIONS=8

# Access control. Both are opt-in; set API_ACCESS_TOKEN before exposing this
# app to anything but localhost — every route spends money on your keys.
# API_ACCESS_TOKEN=
# RATE_LIMIT_PER_MIN=20
# RATE_LIMIT_ORCHESTRATOR_PER_MIN=5
# RATE_LIMIT_NLQ_PER_MIN=10
